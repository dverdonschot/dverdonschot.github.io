[Unit]
Description=Mirror personal-site from Forgejo to GitHub Pages
Documentation=file:///home/ubuntu/projects/personal-site/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/projects/personal-site
ExecStart=/home/ubuntu/projects/personal-site/scripts/sync-to-github.sh
StandardOutput=journal
StandardError=journal
SyslogIdentifier=personal-site-sync

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/ubuntu/projects/personal-site/.git
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
